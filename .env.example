# Server-only credentials. Select a Gemini model with image + structured JSON support available to your account.
GEMINI_API_KEY=
GEMINI_MODEL=

# Server-only connection to the optional NVIDIA Kimodo worker.
KIMODO_URL=http://127.0.0.1:8001
KIMODO_API_TOKEN=

# Public devnet JSON-RPC endpoint. Never put a secret-bearing provider URL here.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Server-only prototype reward attestation. Use independent random values of at
# least 32 bytes. The issuer token belongs only on the trusted analysis service.
REWARD_ATTESTATION_SECRET=
REWARD_ISSUER_TOKEN=
